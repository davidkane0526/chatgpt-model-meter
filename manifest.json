{
  "manifest_version": 3,
  "name": "模型 · 额度监测 for ChatGPT",
  "version": "0.8.2",
  "description": "在 ChatGPT 网页显示 Work / Codex 额度，并以更严格的 STE 证据识别模型路由；支持拖动、缩小额度胶囊与可读模型名称。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js",
        "model.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "widget.js",
        "model-labels.js",
        "model-ui.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ],
  "version_name": "0.8.2-mod"
}
