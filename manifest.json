{
  "manifest_version": 3,
  "name": "ChatGPT 模型 · 额度监测",
  "version": "0.6.0",
  "description": "在 ChatGPT 网页左上角显示 5 小时 / 7 天剩余额度，并核对每次发送请求的 model 与响应回来的 model_slug（chat 与 work 通用）。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js",
        "model.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "widget.js",
        "model-ui.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ]
}
