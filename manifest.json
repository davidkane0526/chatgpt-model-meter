{
  "manifest_version": 3,
  "name": "模型 · 额度监测 for ChatGPT",
  "version": "0.9.0",
  "description": "在 ChatGPT 网页显示 Work / Codex 额度与模型路由，并提供页面保活和消息发送超时自动恢复。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js",
        "model.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "widget.js",
        "model-labels.js",
        "model-ui.js",
        "resilience.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage"
  ],
  "version_name": "0.9.0-mod"
}
